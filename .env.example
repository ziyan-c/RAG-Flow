# Copy to .local/rag-flow.env on the machine that runs the pipeline.

# Private source documents
RAG_FLOW_SOURCE_PDF=.local/CUSTOM_DATA/pdfs/source/example-product/example-technical-manual.pdf
RAG_FLOW_SOURCE_ROOT=.local/CUSTOM_DATA/pdfs/source

# Pipeline workspace on the runtime machine
RAG_FLOW_BASE_DIR=.local/CUSTOM_DATA/pdfs/output/example-product/example-technical-manual/auto
RAG_FLOW_SOURCE_NAME=example-product/example-technical-manual.pdf
RAG_FLOW_CONTENT_JSON=.local/CUSTOM_DATA/pdfs/output/example-product/example-technical-manual/auto/example-technical-manual_content_list.json
RAG_FLOW_SECTIONED_JSON=.local/CUSTOM_DATA/pdfs/output/example-product/example-technical-manual/auto/example-technical-manual_content_list_SECTIONED.json
RAG_FLOW_PATCHED_JSON=.local/CUSTOM_DATA/pdfs/output/example-product/example-technical-manual/auto/example-technical-manual_content_list_SECTIONED_PATCHED.json
RAG_FLOW_CAPTIONED_JSON=.local/CUSTOM_DATA/pdfs/output/example-product/example-technical-manual/auto/example-technical-manual_content_list_SECTIONED_PATCHED_CAPTIONED.json
RAG_FLOW_CHUNKS_JSON=.local/CUSTOM_DATA/pdfs/output/example-product/example-technical-manual/auto/example-technical-manual_content_list_SECTIONED_PATCHED_CAPTIONED_CHUNKED.json
RAG_FLOW_TAGGED_JSON=.local/CUSTOM_DATA/pdfs/output/example-product/example-technical-manual/auto/example-technical-manual_content_list_SECTIONED_PATCHED_CAPTIONED_CHUNKED_TAGGED.json

# Patching
RAG_FLOW_PATCH_MAX_NEW_TOKENS=8000
RAG_FLOW_PATCH_LLM_TIMEOUT=120
RAG_FLOW_PATCH_BATCH_SIZE=512
RAG_FLOW_PATCH_CONCURRENCY=8
RAG_FLOW_PATCH_CHECKPOINT_INTERVAL=1
RAG_FLOW_PATCH_INVALID_RETRY_LIMIT=0
RAG_FLOW_PATCH_DPI=250
RAG_FLOW_PATCH_PAGE_WINDOW_SIZE=200

# Captioning
RAG_FLOW_CAPTION_MAX_NEW_TOKENS=8000
RAG_FLOW_CAPTION_MAX_CONTEXT_TOKENS=2000
RAG_FLOW_CAPTION_MAX_IMAGE_SIDE=2048
RAG_FLOW_CAPTION_BATCH_SIZE=32
RAG_FLOW_CAPTION_CONCURRENCY=3
RAG_FLOW_CAPTION_CHECKPOINT_INTERVAL=1
RAG_FLOW_CAPTION_LLM_TIMEOUT=120

# Chunking
RAG_FLOW_CHUNK_MODE=auto
RAG_FLOW_CHUNK_MAX_TOKENS=1500
RAG_FLOW_CHUNK_OVERLAP_TOKENS=150
RAG_FLOW_CHUNK_MIN_TOKENS=150

# Tagging
# Disabled by default. Set to 1 only when the source root contains metadata.yml.
RAG_FLOW_TAGGING_ENABLED=0

# Indexing
RAG_FLOW_INDEX_MODE=text
RAG_FLOW_INDEX_TEXT_BATCH_SIZE=256
RAG_FLOW_INDEX_VISUAL_BATCH_SIZE=8
RAG_FLOW_INDEX_VISUAL_DPI=200

# Retrieval / benchmark
# Named retrieval/answering preset. The built-in default is low; use
# `rag-flow preset list` to inspect available presets.
RAG_FLOW_PRESET=low
# Choices: text, text-visual-naive, text-visual-bbox.
RAG_FLOW_RETRIEVAL_ROUTE_MODE=text
# Choices: none, page-naive, page-bbox.
RAG_FLOW_RETRIEVAL_VISUAL_BONUS=none
RAG_FLOW_RETRIEVAL_K=150
RAG_FLOW_FINAL_TOP_K=10
RAG_FLOW_RRF_K=10
# Low-latency default keeps visual disabled. This weight is ignored unless the
# visual route is explicitly enabled; it matches the thesis visual optional
# recommendation.
RAG_FLOW_VISUAL_WEIGHT=2.5
# Qdrant scroll page size when expanding matched visual pages; not a candidate cap.
RAG_FLOW_RETRIEVAL_CANDIDATE_SCROLL_PAGE_SIZE=30
RAG_FLOW_RETRIEVAL_MAX_CONTEXT_TOKENS=10000
RAG_FLOW_RETRIEVAL_CONTEXT_CHARS_PER_TOKEN=4.0
RAG_FLOW_RETRIEVAL_MIN_CANDIDATE_SCORE=0
# Allowed score drop from the best candidate. 1.0 disables relative filtering;
# 0.2 keeps candidates scoring at least 80% of the best candidate.
RAG_FLOW_RETRIEVAL_MIN_SCORE_RATIO=0.4
# Final retrieval output defaults to text-only context. Set this to 1 when the
# answering stage should receive OpenAI-compatible image_url items for existing
# image_recommended/image_required evidence images.
RAG_FLOW_RETRIEVAL_FINAL_OUTPUT_IMAGES=0

# MinerU parsing
RAG_FLOW_MINERU_COMMAND=mineru
# This can be one PDF or a folder of PDFs for `rag-flow mineru run`.
# When PDFs are under .local/CUSTOM_DATA/pdfs/source, source_relpath values are
# root-relative paths such as example-product/manual.pdf, with source_filename
# mirrored into Qdrant payloads for filtering and display.
RAG_FLOW_MINERU_INPUT_PATH=.local/CUSTOM_DATA/pdfs/source/example-product/example-technical-manual.pdf
# For folder input, nested PDF folders are mirrored below this output root.
RAG_FLOW_MINERU_OUTPUT_DIR=.local/CUSTOM_DATA/pdfs/output
RAG_FLOW_MINERU_BACKEND=
RAG_FLOW_MINERU_MODEL_SOURCE=
RAG_FLOW_MINERU_LANG=
RAG_FLOW_MINERU_EXTRA_ARGS=
RAG_FLOW_MINERU_PACKAGE=mineru
RAG_FLOW_MINERU_VERSION=3.0.9
RAG_FLOW_MINERU_EXTRA=all
RAG_FLOW_MINERU_PYTHON=
RAG_FLOW_AUTO_INSTALL_MINERU=0

# Local machine initialization used by `rag-flow init china-all` and `rag-flow init china-sources`
RAG_FLOW_INIT_MIRROR_ORDER=aliyun,tencent,tuna
RAG_FLOW_INIT_MIRROR_PROBE=1
RAG_FLOW_INIT_MIRROR_PROBE_TIMEOUT=5
RAG_FLOW_INIT_UPDATE_ENV_FILE=1
RAG_FLOW_INIT_REWRITE_APT=1
RAG_FLOW_INIT_APT_MIRROR=mirrors.aliyun.com
RAG_FLOW_INIT_APT_UPDATE=1
RAG_FLOW_INIT_INSTALL_APT_PACKAGES=1
RAG_FLOW_INIT_APT_PACKAGES=poppler-utils
RAG_FLOW_INIT_CONFIGURE_LOCALE=1
RAG_FLOW_INIT_LOCALE=en_US.UTF-8
RAG_FLOW_INIT_WRITE_BASHRC=1
RAG_FLOW_INIT_BASHRC=
RAG_FLOW_RUNTIME_ROOT=/root/autodl-tmp
RAG_FLOW_INIT_HF_ENDPOINT=https://hf-mirror.com
RAG_FLOW_INIT_HF_HOME=/root/autodl-tmp/.cache/huggingface
RAG_FLOW_INIT_VLLM_USE_MODELSCOPE=True
RAG_FLOW_INIT_MINERU_MODEL_SOURCE=modelscope
RAG_FLOW_INIT_PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
RAG_FLOW_INIT_UV_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
RAG_FLOW_INIT_PIP_CACHE_DIR=/root/autodl-tmp/.cache/pip
RAG_FLOW_INIT_UV_CACHE_DIR=/root/autodl-tmp/.cache/uv
RAG_FLOW_INIT_TORCH_HOME=/root/autodl-tmp/.cache/torch
RAG_FLOW_INIT_MODELSCOPE_CACHE=/root/autodl-tmp/.cache/modelscope
RAG_FLOW_INIT_FASTEMBED_CACHE=/root/autodl-tmp/.cache/fastembed
FASTEMBED_CACHE_PATH=/root/autodl-tmp/.cache/fastembed
RAG_FLOW_INIT_WRITE_CONDARC=1
RAG_FLOW_INIT_CONDARC=
RAG_FLOW_INIT_CONDA_PKGS_DIRS=/root/autodl-tmp/conda-pkgs
RAG_FLOW_INIT_CONDA_MAIN_CHANNEL=https://mirrors.aliyun.com/anaconda/pkgs/main
RAG_FLOW_INIT_CONDA_R_CHANNEL=https://mirrors.aliyun.com/anaconda/pkgs/r
RAG_FLOW_INIT_CONDA_MSYS2_CHANNEL=https://mirrors.aliyun.com/anaconda/pkgs/msys2
RAG_FLOW_INIT_CONDA_FORGE_CHANNEL=https://mirrors.aliyun.com/anaconda/cloud
RAG_FLOW_INIT_CONDA_PYTORCH_CHANNEL=https://mirrors.aliyun.com/anaconda/cloud
RAG_FLOW_INIT_CONDA_CLEAN_INDEX=1

# Python environment creation used by `rag-flow env ...`
RAG_FLOW_ENV_MANAGER=auto
RAG_FLOW_CONDA_EXE=micromamba
RAG_FLOW_ENV_ROOT=/root/autodl-tmp/envs
RAG_FLOW_MINERU_ENV=rag-flow-mineru
RAG_FLOW_PIPELINE_ENV=rag-flow-pipeline
RAG_FLOW_LLM_ENV=rag-flow-llm
RAG_FLOW_MINERU_PYTHON_VERSION=3.12
RAG_FLOW_PIPELINE_PYTHON=3.12
RAG_FLOW_LLM_PYTHON=3.12
RAG_FLOW_PIPELINE_PYTHON_BIN=
RAG_FLOW_LLM_PYTHON_BIN=
RAG_FLOW_UPDATE_ENV_FILE=1
RAG_FLOW_PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
RAG_FLOW_UV_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
RAG_FLOW_USE_UV=1
RAG_FLOW_CREATE_MINERU_INSTALL_UV=1
RAG_FLOW_CREATE_LLM_INSTALL_UV=1
RAG_FLOW_FORCE_INSTALL_UV=0
RAG_FLOW_PIP_CACHE_DIR=/root/autodl-tmp/.cache/pip
RAG_FLOW_UV_CACHE_DIR=/root/autodl-tmp/.cache/uv
RAG_FLOW_CONDA_PKGS_DIRS=/root/autodl-tmp/conda-pkgs
RAG_FLOW_PIPELINE_INSTALL_TORCH=1
RAG_FLOW_PIPELINE_TORCH_INDEX_URL=https://download.pytorch.org/whl/cu128
RAG_FLOW_PIPELINE_TORCH_PACKAGES="torch torchvision torchaudio"
RAG_FLOW_LLM_INSTALL_SPEC=sglang[all]
RAG_FLOW_LLM_FIX_CUDNN=1
RAG_FLOW_LLM_CUDNN_PACKAGE=nvidia-cudnn-cu12==9.16.0.29
RAG_FLOW_LLM_EXTRA_PACKAGES=

# Local OpenAI-compatible LLM server used by `rag-flow serve llm-sglang`
RAG_FLOW_SGLANG_MODEL_PROFILE=qwen3.6-35b-a3b-gptq-int4
RAG_FLOW_SGLANG_MODEL_ID=
RAG_FLOW_SGLANG_MODEL_PATH=
RAG_FLOW_SGLANG_SERVED_MODEL_NAME=
RAG_FLOW_SGLANG_MODEL_REVISION=
RAG_FLOW_SGLANG_LOCAL_MODEL_ROOT=/root/autodl-tmp/models
RAG_FLOW_SGLANG_DOWNLOAD_SOURCE=auto
RAG_FLOW_SGLANG_DOWNLOAD_INSTALL_MODELSCOPE=1
RAG_FLOW_SGLANG_DOWNLOAD_INSTALL_HUGGINGFACE_HUB=1
RAG_FLOW_SGLANG_HF_TOKEN=
RAG_FLOW_SGLANG_PYTHON=
RAG_FLOW_SGLANG_PORT=8080
RAG_FLOW_SGLANG_TP_SIZE=1
RAG_FLOW_SGLANG_MEM_FRACTION_STATIC=0.75
RAG_FLOW_SGLANG_CONTEXT_LENGTH=100000
RAG_FLOW_SGLANG_REASONING_PARSER=qwen3
RAG_FLOW_SGLANG_QUANTIZATION=moe_wna16
RAG_FLOW_SGLANG_ATTENTION_BACKEND=triton
RAG_FLOW_SGLANG_KV_CACHE_DTYPE=fp8_e5m2
RAG_FLOW_SGLANG_EXTRA_ARGS=

# Optional remote GPU machine. Put real credentials only in .local/rag-flow.env.
RAG_FLOW_REMOTE_SSH_HOST=
RAG_FLOW_REMOTE_SSH_PORT=22
RAG_FLOW_REMOTE_SSH_USER=root
RAG_FLOW_REMOTE_SSH_PASSWORD=
RAG_FLOW_REMOTE_WORKDIR=/root/RAG-Flow

# Qdrant local database or server endpoint
RAG_FLOW_DB_PATH=.local/CUSTOM_DATA/qdrant-db
RAG_FLOW_QDRANT_URL=
RAG_FLOW_QDRANT_API_KEY=
RAG_FLOW_QDRANT_PREFER_GRPC=0
RAG_FLOW_QDRANT_TIMEOUT=30
RAG_FLOW_COLLECTION=technical-manuals

# Retrieval models
RAG_FLOW_DENSE_MODEL=intfloat/multilingual-e5-large
RAG_FLOW_DENSE_VECTOR_SIZE=1024
RAG_FLOW_DENSE_EMBEDDING_BATCH_SIZE=8
RAG_FLOW_DENSE_EMBEDDING_DEVICE=auto
RAG_FLOW_DENSE_EMBEDDING_DTYPE=auto
RAG_FLOW_QWEN3_QUERY_INSTRUCTION=Given a customer support technical-manual question, retrieve relevant passages from product manuals that answer the question.
RAG_FLOW_SPARSE_MODEL=Qdrant/bm25
RAG_FLOW_SPARSE_EMBEDDING_BATCH_SIZE=16
RAG_FLOW_SPARSE_EMBEDDING_DEVICES=
RAG_FLOW_SPARSE_EMBEDDING_FP16=1
RAG_FLOW_COLPALI_MODEL=vidore/colpali-v1.3-merged
RAG_FLOW_COLPALI_MODEL_PATH=
RAG_FLOW_COLPALI_LOCAL_MODEL_ROOT=/root/autodl-tmp/models
# Vision model used by patching and captioning through the OpenAI-compatible LLM API.
RAG_FLOW_VLM_BASE_URL=http://localhost:8080/v1
RAG_FLOW_VLM_API_KEY=EMPTY
RAG_FLOW_VLM_MODEL=palmfuture/Qwen3.6-35B-A3B-GPTQ-Int4
RAG_FLOW_VLM_MODEL_REVISION=
RAG_FLOW_TRUSTED_REMOTE_CODE_MODELS=palmfuture/Qwen3.6-35B-A3B-GPTQ-Int4
RAG_FLOW_RETRIEVAL_K=150
RAG_FLOW_FINAL_TOP_K=10
RAG_FLOW_RRF_K=10
RAG_FLOW_VISUAL_WEIGHT=2.5
RAG_FLOW_RETRIEVAL_ROUTE_MODE=text
RAG_FLOW_RETRIEVAL_VISUAL_BONUS=none
RAG_FLOW_RETRIEVAL_DEVICE=auto
RAG_FLOW_RETRIEVAL_MAX_CONTEXT_TOKENS=10000
RAG_FLOW_RETRIEVAL_CONTEXT_CHARS_PER_TOKEN=4.0
RAG_FLOW_RETRIEVAL_MIN_CANDIDATE_SCORE=0
# Allowed score drop from the best candidate. 1.0 disables relative filtering.
RAG_FLOW_RETRIEVAL_MIN_SCORE_RATIO=0.4
RAG_FLOW_QUANTIZED_COLPALI=1
RAG_FLOW_RETRIEVAL_FINAL_OUTPUT_IMAGES=0
RAG_FLOW_ANSWER_MAX_TOKENS=8000
RAG_FLOW_ANSWER_ENABLE_THINKING=0

# Retriever API
RAG_FLOW_RETRIEVER_HOST=127.0.0.1
RAG_FLOW_RETRIEVER_PORT=8000
RAG_FLOW_RETRIEVER_URL=http://127.0.0.1:8000/retrieve
RAG_FLOW_RETRIEVER_API_KEY=
RAG_FLOW_RETRIEVER_MAX_QUERY_CHARS=4000

# LLM API
RAG_FLOW_LLM_BASE_URL=http://localhost:8080/v1
RAG_FLOW_LLM_API_KEY=EMPTY
# Answer/chat model. Patching and captioning use RAG_FLOW_VLM_MODEL instead.
RAG_FLOW_LLM_MODEL=palmfuture/Qwen3.6-35B-A3B-GPTQ-Int4
RAG_FLOW_LLM_MAX_TOKENS=20000

# Optional model-server lifecycle. When enabled, ingest starts the VLM only for
# patching/captioning and stops it afterwards; chat/answering starts the LLM only
# when answers are generated.
RAG_FLOW_VLM_SERVER_AUTO_START=0
RAG_FLOW_VLM_SERVER_STOP_AFTER=1
RAG_FLOW_VLM_SERVER_COMMAND=
RAG_FLOW_VLM_SERVER_LOG_PATH=.local/CUSTOM_DATA/logs/vlm-sglang.log
RAG_FLOW_VLM_SERVER_STARTUP_TIMEOUT=900
RAG_FLOW_VLM_SERVER_POLL_INTERVAL=5
RAG_FLOW_VLM_SGLANG_MODEL_PROFILE=qwen3.6-35b-a3b-gptq-int4
RAG_FLOW_VLM_SGLANG_MODEL_ID=palmfuture/Qwen3.6-35B-A3B-GPTQ-Int4
RAG_FLOW_VLM_SGLANG_MODEL_PATH=
RAG_FLOW_VLM_SGLANG_SERVED_MODEL_NAME=palmfuture/Qwen3.6-35B-A3B-GPTQ-Int4
RAG_FLOW_VLM_SGLANG_PYTHON=
RAG_FLOW_VLM_SGLANG_LOCAL_MODEL_ROOT=/root/autodl-tmp/models
RAG_FLOW_VLM_SGLANG_MEM_FRACTION_STATIC=0.85
RAG_FLOW_VLM_SGLANG_CONTEXT_LENGTH=100000
RAG_FLOW_VLM_SGLANG_TP_SIZE=1
RAG_FLOW_VLM_SGLANG_QUANTIZATION=moe_wna16
RAG_FLOW_VLM_SGLANG_EXTRA_ARGS=

RAG_FLOW_LLM_SERVER_AUTO_START=0
RAG_FLOW_LLM_SERVER_STOP_AFTER=1
RAG_FLOW_LLM_SERVER_COMMAND=
RAG_FLOW_LLM_SERVER_LOG_PATH=.local/CUSTOM_DATA/logs/llm-sglang.log
RAG_FLOW_LLM_SERVER_STARTUP_TIMEOUT=900
RAG_FLOW_LLM_SERVER_POLL_INTERVAL=5
RAG_FLOW_LLM_SGLANG_MODEL_PROFILE=qwen3.6-35b-a3b-gptq-int4
RAG_FLOW_LLM_SGLANG_MODEL_ID=palmfuture/Qwen3.6-35B-A3B-GPTQ-Int4
RAG_FLOW_LLM_SGLANG_MODEL_PATH=
RAG_FLOW_LLM_SGLANG_SERVED_MODEL_NAME=palmfuture/Qwen3.6-35B-A3B-GPTQ-Int4
RAG_FLOW_LLM_SGLANG_PYTHON=
RAG_FLOW_LLM_SGLANG_LOCAL_MODEL_ROOT=/root/autodl-tmp/models
RAG_FLOW_LLM_SGLANG_MEM_FRACTION_STATIC=0.85
RAG_FLOW_LLM_SGLANG_CONTEXT_LENGTH=100000
RAG_FLOW_LLM_SGLANG_TP_SIZE=1
RAG_FLOW_LLM_SGLANG_QUANTIZATION=moe_wna16
RAG_FLOW_LLM_SGLANG_EXTRA_ARGS=

# Optional remote API used by the tool-calling demo.
RAG_FLOW_REMOTE_LLM_URL=https://example.com/api/llm
RAG_FLOW_REMOTE_LLM_API_KEY=
