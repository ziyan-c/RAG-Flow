# Copy to .env on the machine that runs the pipeline.

# Manual workspace
RAG_FLOW_BASE_DIR=/root/autodl-tmp/manuals/public/Dahua-DSS-Professional_User-Manual_V8.7.0/hybrid_auto
RAG_FLOW_SOURCE_NAME=Dahua-DSS-Professional_User-Manual_V8.7.0.pdf
RAG_FLOW_SOURCE_PDF=/root/autodl-tmp/manuals/public/Dahua-DSS-Professional_User-Manual_V8.7.0/hybrid_auto/Dahua-DSS-Professional_User-Manual_V8.7.0_origin.pdf
RAG_FLOW_CONTENT_JSON=/root/autodl-tmp/manuals/public/Dahua-DSS-Professional_User-Manual_V8.7.0/hybrid_auto/Dahua-DSS-Professional_User-Manual_V8.7.0_content_list.json
RAG_FLOW_SMALL_ICON_JSON=/root/autodl-tmp/manuals/public/Dahua-DSS-Professional_User-Manual_V8.7.0/hybrid_auto/Dahua-DSS-Professional_User-Manual_V8.7.0_content_list_small-icon-fixed.json
RAG_FLOW_CAPTIONED_JSON=/root/autodl-tmp/manuals/public/Dahua-DSS-Professional_User-Manual_V8.7.0/hybrid_auto/Dahua-DSS-Professional_User-Manual_V8.7.0_content_list_small-icon-fixed_image-with-captions.json
RAG_FLOW_CHUNKS_JSON=/root/autodl-tmp/manuals/public/Dahua-DSS-Professional_User-Manual_V8.7.0/hybrid_auto/Dahua-DSS-Professional_User-Manual_V8.7.0_page_level_chunks.json

# Qdrant local database
RAG_FLOW_DB_PATH=/root/qdrant-dbs/dahua-db
RAG_FLOW_COLLECTION=dahua-manuals

# Retrieval models
RAG_FLOW_DENSE_MODEL=intfloat/multilingual-e5-large
RAG_FLOW_SPARSE_MODEL=Qdrant/bm25
RAG_FLOW_COLPALI_MODEL=vidore/colpali-v1.3-merged
RAG_FLOW_RETRIEVAL_K=50
RAG_FLOW_FINAL_TOP_K=10
RAG_FLOW_RRF_K=60

# Retriever API
RAG_FLOW_RETRIEVER_HOST=127.0.0.1
RAG_FLOW_RETRIEVER_PORT=8000
RAG_FLOW_RETRIEVER_URL=http://127.0.0.1:8000/retrieve

# LLM API
RAG_FLOW_LLM_BASE_URL=http://localhost:8080/v1
RAG_FLOW_LLM_API_KEY=EMPTY
RAG_FLOW_LLM_MODEL=/root/autodl-tmp/models/Qwen3.5-35B-A3B-GPTQ-Int4
RAG_FLOW_LLM_MAX_TOKENS=2048

# Optional remote API used by the tool-calling demo.
RAG_FLOW_REMOTE_LLM_URL=https://example.com/api/llm
RAG_FLOW_REMOTE_LLM_API_KEY=
