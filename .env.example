# Copy to .local/rag-flow.env on the machine that runs the pipeline.

# Private source documents
RAG_FLOW_SOURCE_PDF=.local/source-documents/example-technical-manual.pdf

# Pipeline workspace on the runtime machine
RAG_FLOW_BASE_DIR=/root/autodl-tmp/manuals/public/example-technical-manual/hybrid_auto
RAG_FLOW_SOURCE_NAME=example-technical-manual.pdf
RAG_FLOW_CONTENT_JSON=/root/autodl-tmp/manuals/public/example-technical-manual/hybrid_auto/example-technical-manual_content_list.json
RAG_FLOW_SMALL_ICON_JSON=/root/autodl-tmp/manuals/public/example-technical-manual/hybrid_auto/example-technical-manual_content_list_small-icon-fixed.json
RAG_FLOW_CAPTIONED_JSON=/root/autodl-tmp/manuals/public/example-technical-manual/hybrid_auto/example-technical-manual_content_list_small-icon-fixed_image-with-captions.json
RAG_FLOW_CHUNKS_JSON=/root/autodl-tmp/manuals/public/example-technical-manual/hybrid_auto/example-technical-manual_page_level_chunks.json

# MinerU parsing
RAG_FLOW_MINERU_COMMAND=mineru
RAG_FLOW_MINERU_INPUT_PATH=.local/source-documents/example-technical-manual.pdf
RAG_FLOW_MINERU_OUTPUT_DIR=/root/autodl-tmp/manuals/public/example-technical-manual
RAG_FLOW_MINERU_BACKEND=
RAG_FLOW_MINERU_MODEL_SOURCE=
RAG_FLOW_MINERU_LANG=
RAG_FLOW_MINERU_EXTRA_ARGS=
RAG_FLOW_MINERU_PACKAGE=mineru
RAG_FLOW_MINERU_VERSION=3.0.9
RAG_FLOW_MINERU_EXTRA=all
RAG_FLOW_MINERU_PYTHON=
RAG_FLOW_AUTO_INSTALL_MINERU=0

# Local machine initialization used by `rag-flow init china-all` and `rag-flow init china-sources`
RAG_FLOW_INIT_MIRROR_ORDER=aliyun,tencent,tuna
RAG_FLOW_INIT_MIRROR_PROBE=1
RAG_FLOW_INIT_MIRROR_PROBE_TIMEOUT=5
RAG_FLOW_INIT_UPDATE_ENV_FILE=1
RAG_FLOW_INIT_REWRITE_APT=1
RAG_FLOW_INIT_APT_MIRROR=mirrors.aliyun.com
RAG_FLOW_INIT_APT_UPDATE=1
RAG_FLOW_INIT_CONFIGURE_LOCALE=1
RAG_FLOW_INIT_LOCALE=en_US.UTF-8
RAG_FLOW_INIT_WRITE_BASHRC=1
RAG_FLOW_INIT_BASHRC=
RAG_FLOW_RUNTIME_ROOT=/root/autodl-tmp
RAG_FLOW_INIT_HF_ENDPOINT=https://hf-mirror.com
RAG_FLOW_INIT_HF_HOME=/root/autodl-tmp/.cache/huggingface
RAG_FLOW_INIT_VLLM_USE_MODELSCOPE=True
RAG_FLOW_INIT_MINERU_MODEL_SOURCE=modelscope
RAG_FLOW_INIT_PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
RAG_FLOW_INIT_UV_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
RAG_FLOW_INIT_PIP_CACHE_DIR=/root/autodl-tmp/.cache/pip
RAG_FLOW_INIT_UV_CACHE_DIR=/root/autodl-tmp/.cache/uv
RAG_FLOW_INIT_TORCH_HOME=/root/autodl-tmp/.cache/torch
RAG_FLOW_INIT_MODELSCOPE_CACHE=/root/autodl-tmp/.cache/modelscope
RAG_FLOW_INIT_WRITE_CONDARC=1
RAG_FLOW_INIT_CONDARC=
RAG_FLOW_INIT_CONDA_PKGS_DIRS=/root/autodl-tmp/conda-pkgs
RAG_FLOW_INIT_CONDA_MAIN_CHANNEL=https://mirrors.aliyun.com/anaconda/pkgs/main
RAG_FLOW_INIT_CONDA_R_CHANNEL=https://mirrors.aliyun.com/anaconda/pkgs/r
RAG_FLOW_INIT_CONDA_MSYS2_CHANNEL=https://mirrors.aliyun.com/anaconda/pkgs/msys2
RAG_FLOW_INIT_CONDA_FORGE_CHANNEL=https://mirrors.aliyun.com/anaconda/cloud
RAG_FLOW_INIT_CONDA_PYTORCH_CHANNEL=https://mirrors.aliyun.com/anaconda/cloud
RAG_FLOW_INIT_CONDA_CLEAN_INDEX=1

# Python environment creation used by `rag-flow env ...`
RAG_FLOW_ENV_MANAGER=auto
RAG_FLOW_CONDA_EXE=micromamba
RAG_FLOW_ENV_ROOT=/root/autodl-tmp/envs
RAG_FLOW_CORE_ENV=rag-flow-core
RAG_FLOW_MINERU_ENV=rag-flow-mineru
RAG_FLOW_GPU_ENV=rag-flow-gpu
RAG_FLOW_LLM_ENV=rag-flow-llm
RAG_FLOW_CORE_PYTHON=3.12
RAG_FLOW_MINERU_PYTHON_VERSION=3.12
RAG_FLOW_GPU_PYTHON=3.12
RAG_FLOW_LLM_PYTHON=3.12
RAG_FLOW_UPDATE_ENV_FILE=1
RAG_FLOW_PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
RAG_FLOW_UV_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
RAG_FLOW_PIP_CACHE_DIR=/root/autodl-tmp/.cache/pip
RAG_FLOW_UV_CACHE_DIR=/root/autodl-tmp/.cache/uv
RAG_FLOW_CONDA_PKGS_DIRS=/root/autodl-tmp/conda-pkgs
RAG_FLOW_GPU_INSTALL_TORCH=1
RAG_FLOW_GPU_TORCH_INDEX_URL=https://download.pytorch.org/whl/cu128
RAG_FLOW_GPU_TORCH_PACKAGES="torch torchvision torchaudio"
RAG_FLOW_LLM_INSTALL_SPEC=sglang[all]

# Optional remote GPU machine. Put real credentials only in .local/rag-flow.env.
RAG_FLOW_REMOTE_SSH_HOST=
RAG_FLOW_REMOTE_SSH_PORT=22
RAG_FLOW_REMOTE_SSH_USER=root
RAG_FLOW_REMOTE_SSH_PASSWORD=
RAG_FLOW_REMOTE_WORKDIR=/root/RAG-Flow

# Qdrant local database
RAG_FLOW_DB_PATH=/root/qdrant-dbs/manual-db
RAG_FLOW_COLLECTION=technical-manuals

# Retrieval models
RAG_FLOW_DENSE_MODEL=intfloat/multilingual-e5-large
RAG_FLOW_SPARSE_MODEL=Qdrant/bm25
RAG_FLOW_COLPALI_MODEL=vidore/colpali-v1.3-merged
RAG_FLOW_VLM_MODEL=Qwen/Qwen3.5-9B
RAG_FLOW_VLM_MODEL_REVISION=
RAG_FLOW_TRUSTED_REMOTE_CODE_MODELS=Qwen/Qwen3.5-9B
RAG_FLOW_RETRIEVAL_K=50
RAG_FLOW_FINAL_TOP_K=10
RAG_FLOW_RRF_K=60

# Retriever API
RAG_FLOW_RETRIEVER_HOST=127.0.0.1
RAG_FLOW_RETRIEVER_PORT=8000
RAG_FLOW_RETRIEVER_URL=http://127.0.0.1:8000/retrieve
RAG_FLOW_RETRIEVER_API_KEY=
RAG_FLOW_RETRIEVER_MAX_QUERY_CHARS=4000

# LLM API
RAG_FLOW_LLM_BASE_URL=http://localhost:8080/v1
RAG_FLOW_LLM_API_KEY=EMPTY
RAG_FLOW_LLM_MODEL=/root/autodl-tmp/models/Qwen3.5-35B-A3B-GPTQ-Int4
RAG_FLOW_LLM_MAX_TOKENS=20000

# Optional remote API used by the tool-calling demo.
RAG_FLOW_REMOTE_LLM_URL=https://example.com/api/llm
RAG_FLOW_REMOTE_LLM_API_KEY=
