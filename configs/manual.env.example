# This file mirrors ../.env.example. Keep project-specific values here if you
# want multiple manual profiles.
RAG_FLOW_SOURCE_PDF=.local/source-documents/example-technical-manual.pdf
RAG_FLOW_SOURCE_ROOT=.local/source-documents
RAG_FLOW_BASE_DIR=/root/autodl-tmp/manuals/public/example-technical-manual/hybrid_auto
RAG_FLOW_SOURCE_NAME=example-technical-manual.pdf
RAG_FLOW_MINERU_INPUT_PATH=.local/source-documents/example-technical-manual.pdf
RAG_FLOW_MINERU_OUTPUT_DIR=/root/autodl-tmp/manuals/public/example-technical-manual
RAG_FLOW_MINERU_BACKEND=
RAG_FLOW_MINERU_MODEL_SOURCE=
RAG_FLOW_MINERU_VERSION=3.0.9
RAG_FLOW_DB_PATH=/root/qdrant-dbs/manual-db
RAG_FLOW_COLLECTION=technical-manuals
RAG_FLOW_DENSE_MODEL=intfloat/multilingual-e5-large
RAG_FLOW_SPARSE_MODEL=Qdrant/bm25
RAG_FLOW_COLPALI_MODEL=vidore/colpali-v1.3-merged
RAG_FLOW_VLM_MODEL=Qwen/Qwen3.5-9B
RAG_FLOW_TRUSTED_REMOTE_CODE_MODELS=Qwen/Qwen3.5-9B
