# This file mirrors ../.env.example. Keep project-specific values here if you
# want multiple manual profiles.
RAG_FLOW_SOURCE_PDF=pdfs/source/example-technical-manual.pdf
RAG_FLOW_SOURCE_ROOT=pdfs/source
RAG_FLOW_BASE_DIR=pdfs/output/example-technical-manual/auto
RAG_FLOW_SOURCE_NAME=example-technical-manual.pdf
RAG_FLOW_MINERU_INPUT_PATH=pdfs/source/example-technical-manual.pdf
RAG_FLOW_MINERU_OUTPUT_DIR=pdfs/output
RAG_FLOW_MINERU_BACKEND=
RAG_FLOW_MINERU_MODEL_SOURCE=
RAG_FLOW_MINERU_VERSION=3.0.9
RAG_FLOW_DB_PATH=qdrant-db
RAG_FLOW_COLLECTION=technical-manuals
RAG_FLOW_DENSE_MODEL=intfloat/multilingual-e5-large
RAG_FLOW_DENSE_VECTOR_SIZE=1024
RAG_FLOW_DENSE_EMBEDDING_BATCH_SIZE=8
RAG_FLOW_DENSE_EMBEDDING_DEVICE=auto
RAG_FLOW_DENSE_EMBEDDING_DTYPE=auto
RAG_FLOW_QWEN3_QUERY_INSTRUCTION=Given a customer support technical-manual question, retrieve relevant passages from product manuals that answer the question.
RAG_FLOW_SPARSE_MODEL=Qdrant/bm25
RAG_FLOW_SPARSE_EMBEDDING_BATCH_SIZE=16
RAG_FLOW_SPARSE_EMBEDDING_DEVICES=
RAG_FLOW_SPARSE_EMBEDDING_FP16=1
RAG_FLOW_COLPALI_MODEL=vidore/colpali-v1.3-merged
# Vision model used by patching and captioning.
RAG_FLOW_VLM_BASE_URL=http://localhost:8080/v1
RAG_FLOW_VLM_API_KEY=EMPTY
RAG_FLOW_VLM_MODEL=palmfuture/Qwen3.6-35B-A3B-GPTQ-Int4
RAG_FLOW_VLM_MODEL_REVISION=
RAG_FLOW_TRUSTED_REMOTE_CODE_MODELS=palmfuture/Qwen3.6-35B-A3B-GPTQ-Int4
RAG_FLOW_LLM_BASE_URL=http://localhost:8080/v1
RAG_FLOW_LLM_API_KEY=EMPTY
RAG_FLOW_LLM_MODEL=palmfuture/Qwen3.6-35B-A3B-GPTQ-Int4
RAG_FLOW_LLM_MAX_TOKENS=20000
RAG_FLOW_VLM_SERVER_AUTO_START=0
RAG_FLOW_VLM_SERVER_STOP_AFTER=1
RAG_FLOW_VLM_SERVER_LOG_PATH=CUSTOM_DATA/logs/vlm-sglang.log
RAG_FLOW_VLM_SGLANG_MODEL_PROFILE=qwen3.6-35b-a3b-gptq-int4
RAG_FLOW_VLM_SGLANG_MODEL_ID=palmfuture/Qwen3.6-35B-A3B-GPTQ-Int4
RAG_FLOW_VLM_SGLANG_SERVED_MODEL_NAME=palmfuture/Qwen3.6-35B-A3B-GPTQ-Int4
RAG_FLOW_VLM_SGLANG_LOCAL_MODEL_ROOT=/root/autodl-tmp/models
RAG_FLOW_VLM_SGLANG_MEM_FRACTION_STATIC=0.85
RAG_FLOW_VLM_SGLANG_CONTEXT_LENGTH=100000
RAG_FLOW_VLM_SGLANG_QUANTIZATION=moe_wna16
RAG_FLOW_LLM_SERVER_AUTO_START=0
RAG_FLOW_LLM_SERVER_STOP_AFTER=1
RAG_FLOW_LLM_SERVER_LOG_PATH=CUSTOM_DATA/logs/llm-sglang.log
RAG_FLOW_LLM_SGLANG_MODEL_PROFILE=qwen3.6-35b-a3b-gptq-int4
RAG_FLOW_LLM_SGLANG_MODEL_ID=palmfuture/Qwen3.6-35B-A3B-GPTQ-Int4
RAG_FLOW_LLM_SGLANG_SERVED_MODEL_NAME=palmfuture/Qwen3.6-35B-A3B-GPTQ-Int4
RAG_FLOW_LLM_SGLANG_LOCAL_MODEL_ROOT=/root/autodl-tmp/models
RAG_FLOW_LLM_SGLANG_MEM_FRACTION_STATIC=0.85
RAG_FLOW_LLM_SGLANG_CONTEXT_LENGTH=100000
RAG_FLOW_LLM_SGLANG_QUANTIZATION=moe_wna16
